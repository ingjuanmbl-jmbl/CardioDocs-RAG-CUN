,"height":196},"id":"KcLwdLm1pFtr","executionInfo":{"status":"ok","timestamp":1794234255769,"user_tz":300,"elapsed":2110,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"8e2bad75-484a-4007-c325-31e003e24fbb"},"execution_count":3,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.Markdown object>"],"text/markdown":"## Configurar conexión"},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Iniciando prueba de Gemini...\n","\n","RESULTADO:\n","Conexión exitosa con Gemini.\n","\n","Tiempo: 1.1 segundos\n","Modelo: gemini-3.5-flash-lite\n"]}]},{"cell_type":"markdown","source":["## Recuperar las credenciales y conectarse a Qdrant"],"metadata":{"id":"w1zAz3oWuLNK"}},{"cell_type":"code","source":["# ============================================================\n","# 7.1. CONEXIÓN CON QDRANT CLOUD Y GEMINI\n","# ============================================================\n","\n","from qdrant_client import QdrantClient, models\n","from sentence_transformers import SentenceTransformer\n","\n","\n","\n","# Recuperar credenciales\n","QDRANT_URL = userdata.get(\"QDRANT_URL\")\n","QDRANT_API_KEY = userdata.get(\"QDRANT_API_KEY\")\n","GEMINI_API_KEY = userdata.get(\"GEMINI_API_KEY\")\n","\n","# Validar credenciales\n","if not all([QDRANT_URL, QDRANT_API_KEY, GEMINI_API_KEY]):\n","    raise ValueError(\"Faltan credenciales en los secretos de Colab.\")\n","\n","# Configurar colección\n","COLLECTION_NAME = \"corpus_cardiovascular\"\n","\n","# Conectar con Qdrant\n","client = QdrantClient(\n","    url=QDRANT_URL,\n","    api_key=QDRANT_API_KEY,\n","    timeout=60\n",")\n","\n","# Verificar colección\n","info = client.get_collection(COLLECTION_NAME)\n","\n","print(\"CONEXIÓN CON QDRANT EXITOSA\")\n","print(\"Colección:\", COLLECTION_NAME)\n","print(\"Puntos almacenados:\", info.points_count)\n","print(\"Dimensiones:\", info.config.params.vectors.size)\n","\n","# Validar compatibilidad\n","as