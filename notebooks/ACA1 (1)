oints(\n","        collection_name=COLLECTION_NAME,\n","        query=embedding_consulta,\n","        query_filter=filtro,\n","        limit=top_k,\n","        with_payload=True,\n","        with_vectors=False\n","    )\n","\n","    # Estandarizar los resultados\n","    resultados = []\n","\n","    for posicion, punto in enumerate(respuesta.points, start=1):\n","        payload = punto.payload or {}\n","\n","        resultados.append({\n","            \"ranking\": posicion,\n","            \"score\": round(float(punto.score), 4),\n","            \"tipo_fuente\": payload.get(\"tipo_fuente\", \"sin_clasificar\"),\n","            \"documento\": payload.get(\"documento\", payload.get(\"dataset\")),\n","            \"pagina\": payload.get(\"pagina\"),\n","            \"registro_id\": payload.get(\"registro_id\"),\n","            \"texto\": payload.get(\"texto\", \"\")\n","        })\n","\n","    return resultados\n","\n"],"metadata":{"id":"yuFqPCYy6kll","executionInfo":{"status":"ok","timestamp":1791989930041,"user_tz":300,"elapsed":38,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}}},"execution_count":31,"outputs":[]},{"cell_type":"code","source":["\n","\n","client.create_payload_index(\n","    collection_name=COLLECTION_NAME,\n","    field_name=\"tipo_fuente\",\n","    field_schema=models.PayloadSchemaType.KEYWORD,\n","    wait=True\n",")\n","\n","print(\"Índice tipo_fuente creado correctamente.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"QUNMBR1O7W4c","executionInfo":{"status":"ok","timestamp":1791990013002,"user_tz":300,"elapsed":527,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"14ba19de-aa73-480b-ba24-25fcdd5755f3"},"execution_count":32,"outputs":[{"output_type":"stream","name":"stdout","text":["Índice tipo_fuente creado correctamente.\n"]}]},{"cell_type":"code","source":["pregunta = \"¿Qué factores se relacionan con la enfermedad cardíaca?\"\n","\n","res