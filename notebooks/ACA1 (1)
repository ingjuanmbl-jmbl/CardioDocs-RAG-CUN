= QdrantClient(\n","    url=QDRANT_URL,\n","    api_key=QDRANT_API_KEY,\n","    timeout=30\n",")\n","\n","# Verificar conectividad consultando las colecciones disponibles\n","collections_response = client.get_collections()\n","\n","print(\"Conexión con Qdrant Cloud establecida.\")\n","print(\"\\nColecciones existentes:\")\n","\n","if collections_response.collections:\n","    for collection in collections_response.collections:\n","        print(\"-\", collection.name)\n","else:\n","    print(\"No hay colecciones creadas todavía.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"ZjIZ_DfkceCk","executionInfo":{"status":"ok","timestamp":1791983308067,"user_tz":300,"elapsed":881,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"f09d0448-aba3-471c-8b41-4d63ff96a014"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Conexión con Qdrant Cloud establecida.\n","\n","Colecciones existentes:\n","No hay colecciones creadas todavía.\n"]}]},{"cell_type":"code","source":[],"metadata":{"id":"3sifB3mtciTV"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["## 4. Selección del corpus documental\n","Antes de crear la colección, debemos definir qué información vamos a indexar."],"metadata":{"id":"qwyv-jK-c0K2"}},{"cell_type":"code","source":["\n","# ============================================================\n","# 4.1. PREPARACIÓN DEL CORPUS DOCUMENTAL\n","# ============================================================\n","\n","\n","# Validar que la ruta del corpus esté definida\n","if \"CORPUS_DIR\" not in globals():\n","    raise NameError(\n","        \"No se encontró CORPUS_DIR. \"\n","        \"Ejecuta primero la celda de configuración de Google Drive.\"\n","    )\n","\n","# Asegurar que la carpeta exista\n","CORPUS_DIR.mkdir(parents=True, exist_ok=True)\n","\n","# Identificar documentos PDF disponibles\n","pdf_files = sorted(CORPUS_DIR.glob(\"*.pdf\"))\n","\n","print(\"Carpeta del corpus:\", CORPUS_DIR)\n","print(\"Documentos PDF encontrados:\", len(pdf_files))\n","\n","for pdf in pdf_files:\n","    print(\"-\", pdf.name)\n","\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"lfgEBTxzdCkE","executionInfo":{"status":"ok","timestamp":1791983308169,"user_tz":300,"elapsed":58,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"54e6942d-cd38-4b91-c38b-032cbd8ca4f3"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Carpeta del corpus: /content/drive/MyDrive/3. ESP IA/6. Computación en la Nube para sistemas inteligentes/ACA1/corpus_cardiovascular\n","Documentos PDF encontrados: 4\n","- 01_gcp-completa-sindrome-coronario-agudo-2da-ed.pdf\n","- 02_directrices-evaluacion-manejo-riesgo-cv-oms.pdf\n","- 03_ ¿OPSNMH19006_spa.pdf\n","- 04_gpc-profesionales-hipertension-arterial-primaria.pdf\n"]}]},{"cell_type":"code","source":["\n","# ============================================================\n","# 4.2. EXTRACCIÓN Y VALIDACIÓN DEL CORPUS DOCUMENTAL\n","# ============================================================\n","\n","\n","\n","documentos = []\n","\n","for pdf_path in sorted(CORPUS_DIR.glob(\"*.pdf\")):\n","    try:\n","        reader = PdfReader(str(pdf_path))\n","\n","        paginas_texto = []\n","        for numero_pagina, pagina in enumerate(reader.pages, start=1):\n","            texto = pagina.extract_text() or \"\"\n","            if texto.strip():\n","                paginas_texto.append({\n","                    \"pagina\": numero_pagina,\n","                    \"texto\": texto.strip()\n","                })\n","\n","        texto_completo = \"\\n\\n\".join(\n","            pagina[\"texto\"] for pagina in paginas_texto\n","        )\n","\n","        documentos.append({\n","            \"documento\": pdf_path.name,\n","            \"ruta\": str(pdf_path),\n","            \"paginas_pdf\": len(reader.pages),\n","         