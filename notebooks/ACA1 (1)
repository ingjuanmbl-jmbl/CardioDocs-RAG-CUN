urce":["## 5.4. Integrar el dataset en Qdrant Cloud\n","\n","Vamos a incorporar los 297 registros a la colección corpus_cardiovascular, conservando los 1.855 fragmentos documentales que ya están almacenados.\n","\n","##Verificar la colección antes de insertar"],"metadata":{"id":"Y92EAG2f5_ei"}},{"cell_type":"code","source":["# Verificar la colección antes de integrar el dataset\n","\n","info = client.get_collection(collection_name=COLLECTION_NAME)\n","total_actual = info.points_count\n","\n","print(\"Colección:\", COLLECTION_NAME)\n","print(\"Puntos actuales:\", total_actual)\n","print(\"Dimensión configurada:\", info.config.params.vectors.size)\n","print(\"Distancia:\", info.config.params.vectors.distance)\n","\n","assert total_actual == 1855, (\n","    f\"Se esperaban 1855 puntos documentales, pero hay {total_actual}. \"\n","    \"Revisemos la colección antes de insertar.\"\n",")\n","\n","assert info.config.params.vectors.size == 384, (\n","    \"La dimensión de la colección no coincide con los embeddings.\"\n",")\n","\n","print(\"\\nValidaciones superadas. Podemos integrar el dataset.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"gRQvq8Fx5tUn","executionInfo":{"status":"ok","timestamp":1791989671739,"user_tz":300,"elapsed":511,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"77e9052a-fb80-4502-df3c-829264e5ac1f"},"execution_count":26,"outputs":[{"output_type":"stream","name":"stdout","text":["Colección: corpus_cardiovascular\n","Puntos actuales: 1855\n","Dimensión configurada: 384\n","Distancia: Cosine\n","\n","Validaciones superadas. Podemos integrar el dataset.\n"]}]},{"cell_type":"markdown","source":["> ¿Por qué verificamos primero? Para evitar insertar registros duplicados o asignar identificadores que colisionen con los puntos documentales existentes."],"metadata":{"id":"0nSZATIB6LNC"}},{"cell_type":"markdown","source":["## 5.5 — Preparar e insertar los registros"],"metadata":{"id":"YomPlba36TOU"}},{"cell_type":"code","source":["\n","\n","# 1. Etiquetar los fragmentos documentales existentes\n","ids_documentos = list(range(1, 1856))\n","\n","for inicio in range(0, len(ids_documentos), 100):\n","    lote_ids = ids_documentos[inicio:inicio + 100]\n","\n","    client.set_payload(\n","        collection_name=COLLECTION_NAME,\n","        payload={\"tipo_fuente\": \"documento_pdf\"},\n","        points=lote_ids,\n","        wait=True\n","    )\n","\n","print(\"Fragmentos PDF etiquetados:\", len(ids_documentos))\n","\n","\n","# 2. Preparar los 297 puntos del dataset estructurado\n","puntos_dataset = []\n","\n","for i, fila in df_vector.iterrows():\n","    # Conservar las variables predictoras como metadatos\n","    metadatos = {}\n","\n","    for columna in columnas_predictoras:\n","        valor = fila[columna]\n","\n","        if isinstance(valor, np.generic):\n","            valor = valor.item()\n","\n","        metadatos[columna] = valor\n","\n","    payload = {\n","        \"registro_id\": str(fila[\"registro_id\"]),\n","        \"tipo_fuente\": \"dataset_estructurado\",\n","        \"sector\": \"salud\",\n","        \"dataset\": \"UCI Heart Disease\",\n","        \"texto\": str(fila[\"texto\"]),\n","        \"diagnostico_enfermedad_cardiaca\": int(\n","            fila[\"diagnostico_enfermedad_cardiaca\"]\n","        ),\n","        \"modelo_embedding\": MODEL_NAME,\n","        **metadatos\n","    }\n","\n","    puntos_dataset.append(\n","        models.PointStruct(\n","            id=1856 + i,\n","            vector=embeddings_dataset[i].tolist(),\n","            payload=payload\n","        )\n","    )\n","\n","\n","# 3. Insertar en lotes de 100\n","for inicio in range(0, len(puntos_dataset), 100):\n","    lote = puntos_dataset[inicio:inicio + 100]\n","\n","    client.upsert(\n","        collection_name=COLLECTION_NAME,\n","        points=lote,\n","        wait=True\n","    )\n","\n","    print(\n","        f\"Lote procesado: {inicio + 1}–\"\n","        f\"{inicio + len(lote)} de {len(puntos_dataset)}\"\n","    )\n","\n","print(\"\\nIntegración del dataset completada.\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"Xj6UoB-36GQe","executionInfo":{"status":"ok","timestamp":1791989747161,"user_tz":300,"elapsed":4826,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"e7b43f02-88f0-4801-a534-16e94da2b606"},"execution_count":27,"outputs":[{"output_type":"stream","name":"stdout","text":["Fragmentos PDF etiquetados: 1855\n","Lote procesado: 1–100 de 297\n","Lote procesado: 101–200 de 297\n","Lote procesado: 201–297 de 297\n","\n","Integración del dataset completada.\n"]}]},{"cell_type":"markdown","source":["## 5.6 — Verificar la integración"],"metadata":{"id":"I1kFXW-m6gbY"}},{"cell_type":"code","source":["# Verificar el total de puntos en Qdrant\n","info = client.get_collection(collection_name=COLLECTION_NAME)\n","\n","print(\"Total de puntos:\", info.points_count)\n","print(\"Total esperado:\", 2152)\n","\n","# Consultar un punto documental\n","pdf = client.retrieve(\n","    collection_name=COLLECTION_NAME,\n","    ids=[1],\n","    with_payload=True,\n","    with_vectors=False\n",")\n","\n","# Consultar un registro estructurado\n","dataset = client.retrieve(\n","    collection_name=COLLECTION_NAME,\n","    ids=[1856],\n","    with_payload=True,\n","    with_vectors=False\n",")\n","\n","assert info.points_count == 2152\n","assert pdf and pdf[0].payload[\"tipo_fuente\"] == \"documento_pdf\"\n","assert dataset and dataset[0].payload[\"tipo_fuente\"] == \"dataset_estructurado\"\n","\n","print(\"\\nDocumento PDF:\", pdf[0].payload[\"documento\"])\n","print(\"Registro:\", dataset[0].payload[\"registro_id\"])\n","print(\"Dataset:\", dataset[0].payload[\"dataset\"])\n","print(\n","    \"Diagnóstico codificado:\",\n","    dataset[0].payload[\"diagnostico_enfermedad_cardiaca\"]\n",")\n","print(\"\\nVerificación completada.\")"],"metadata":{"colab":{"base_uri"