ta.get(\"QDRANT_URL\")\n","QDRANT_API_KEY = userdata.get(\"QDRANT_API_KEY\")\n","\n","if not QDRANT_URL or not QDRANT_API_KEY:\n","    raise ValueError(\n","        \"Verifica los secretos QDRANT_URL y QDRANT_API_KEY en Colab.\"\n","    )\n","\n","client = QdrantClient(\n","    url=QDRANT_URL,\n","    api_key=QDRANT_API_KEY,\n","    timeout=60\n",")\n","\n","COLLECTION_NAME = \"corpus_cardiovascular\"\n","\n","# Crear la colección si aún no existe.\n","# Si existe, se conserva para evitar borrar datos accidentalmente.\n","if not client.collection_exists(COLLECTION_NAME):\n","    client.create_collection(\n","        collection_name=COLLECTION_NAME,\n","        vectors_config=models.VectorParams(\n","            size=384,\n","            distance=models.Distance.COSINE\n","        )\n","    )\n","    print(f\"Colección creada: {COLLECTION_NAME}\")\n","else:\n","    print(f\"La colección ya existe: {COLLECTION_NAME}\")\n","\n","# Verificar configuración\n","info = client.get_collection(COLLECTION_NAME)\n","\n","print(\"Estado:\", info.status)\n","print(\"Vectores registrados:\", info.points_count)\n","print(\"Configuración vectorial:\", info.config.params.vectors)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"87Dw6VvotPwj","executionInfo":{"status":"ok","timestamp":1791987032714,"user_tz":300,"elapsed":2259,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"05d0bfaf-2db1-43c5-b33e-8d0e062a7b31"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Colección creada: corpus_cardiovascular\n","Estado: green\n","Vectores registrados: 0\n","Configuración vectorial: size=384 distance=<Distance.COSINE: 'Cosine'> hnsw_config=None quantization_config=None on_disk=None memory=None datatype=None multivector_config=None\n"]}]},{"cell_type":"markdown","source":["¿Qué estamos configurando?\n","- Colección: corpus_cardiovascular.\n","- Dimensión: 384, igual a la salida del modelo E5.\n","- Distancia: coseno, para comparar la similitud semántica.\n","- Persistencia: Qdrant Cloud conserva los puntos indexados independientemente de la sesión de Colab."],"metadata":{"id":"5wgzwBj_wKBx"}},{"cell_type":"markdown","source":["### Paso 5. Indexar los embeddings en Qdrant Cloud"],"metadata":{"id":"cdIQ1bjewQMb"}},{"cell_type":"code","source":["\n","# ============================================================\n","# 4.6. INDEXACIÓN DE EMBEDDINGS EN QDRANT CLOUD\n","# ============================================================\n","\n","\n","\n","BATCH_SIZE = 100\n","\n","# Validar correspondencia entre chunks y embeddings\n","assert len(chunks_validos) == len(embeddings)\n","assert embeddings.shape[1] == 384\n","\n","# Crear puntos con identificadores deterministas\n","puntos = []\n","\n","for i, (chunk, vector) in enumerate(zip(chunks_validos, embeddings)):\n","    payload = {\n","        \"chunk_id\": chunk[\"chunk_id\"],\n","        \"documento\": chunk[\"documento\"],\n","        \"pagina\": int(chunk[\"pagina\"]),\n","        \"texto\": chunk[\"texto\"],\n","        \"caracteres\": int(chunk[\"caracteres\"]),\n","        \"sector\": \"salud\",\n","        \"tema\": \"enfermedades cardiovasculares\",\n","        \"modelo_embedding\": MODEL_NAME\n","    }\n","\n","    puntos.append(\n","        models.PointStruct(\n","            id=i + 1,\n","            vector=vector.tolist(),\n","            payload=payload\n","        )\n","    )\n","\n","# Cargar por lotes\n","for inicio in range(0, len(puntos), BATCH_SIZE):\n","    lote = puntos[inicio:inicio + BATCH_SIZE]\n","\n","    client.upsert(\n","        collection_name=COLLECTION_NAME,\n","        points=lote,\n","        wait=True\n","    )\n","\n","    print(\n","        f\"Indexados {min(inicio + len(lote), len(puntos))}\"\n","        f\" de {len(puntos)} puntos\"\n","    )\n","\n","print(\"\\nIndexación finalizada.\")\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"sETmkZ9owBif","executionInfo":{"status":"ok","timestamp":1791987118424,"user_tz":300,"elapsed":4932,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"0d4a761c-9ad8-4402-9a6d-40ee0e2ad9b5"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Indexados 100 de 1855 puntos\n","Indexados 200 de 1855 puntos\n","Indexados 300 de 1855 puntos\n","Indexados 400 de 1855 puntos\n","Indexados 500 de 1855 puntos\n","Indexados 600 de 1855 puntos\n","Indexados 700 de 1855 puntos\n","Indexados 800 de 1855 puntos\n","Indexados 900 de 1855 puntos\n","Indexados 1000 de 1855 puntos\n","Indexados 1100 de 1855 puntos\n","Indexados 1200 de 1855 puntos\n","Indexados 1300 de 1855 puntos\n","Indexados 1400 de 1855 puntos\n","Indexados 1500 de 1855 puntos\n","Indexados 1600 de 1855 puntos\n","Indexados 1700 de 1855 puntos\n","Indexados 1800 de 1855 puntos\n","Indexados 1855 de 1855 puntos\n","\n","Indexación finalizada.\n"]}]},{"cell_type":"code","source":["\n","# ============================================================\n","# 4.7. VERIFICACIÓN DE LA INDEXACIÓN\n","# ============================================================\n","\n","info = client.get_collection(COLLECTION_NAME)\n","\n","print(\"Colección:\", COLLECTION_NAME)\n","print(\"Estado:\", info.status)\n","print(\"Puntos almacenados:\", info.points_count)\n","print(\"Puntos esperados:\", len(chunks_validos))\n","\n","assert info.points_count == len(chunks_validos), (\n","    \"La cantidad de puntos almacenados no coincide con la esperada.\"\n",")\n","\n","# Recuperar un punto para comprobar texto y metadatos\n","resultado = client.retrieve(\n","    collection_name=COLLECTION_NAME,\n","    ids=[1],\n","    with_payload=True,\n","    with_vectors=False\n",")\n","\n","if resultado:\n","    punto = resultado[0]\n","    print(\"\\nEjemplo recuperado:\")\n","    print(\"ID:\", punto.id)\n","    print(\"Documento:\", punto.payload[\"documento\"])\n","    print(\"Página:\", punto.payload[\"pagina\"])\n","    print(\"Sector:\", punto.payload[\"sector\"])\n","    print(\"Texto:\", punto.payload[\"texto\"][:300])\n","\n","print(\"\\nValidación completada.\")\n"],"metadata":{"id":"_sdS1jTwwVzW","colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"status":"ok","timestamp":1791987307011,"user_tz":300,"elapsed":760,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"b3c6b55d-1c51-4760-9e5d-d2d4e9958ff7"},"execution_count":14,"outputs":[{"output_type":"stream","name":"stdout","text":["Colección: corpus_cardiovascular\n","Estado: green\n","Puntos almacenados: 1855\n","Puntos esperados: 1855\n","\n","Ejemplo recuperado:\n","ID: 1\n","Documento: 01_gcp-completa-sindrome-coronario-agudo-2da-ed.pdf\n","Página: 1\n","Sector: salud\n","Texto: El Síndrome Coronario Agudo Guía de práctica clínica para Sistema General de Seguridad Social en Salud – Colombia Guía Completa 2a. Edición GPC-2013-17 Centro Nacional de Investigación y Tecnologías en Salud, CINETS\n","\n","Validación completada.\n"]}]},{"cell_type":"code","source":["\n","# ============================================================\n","# 4.8. BÚSQUEDA SEMÁNTICA TOP-K\n","# ============================================================\n","\n","def buscar_semanticamente(pregunta, top_k=5):\n","    # E5 requiere el prefijo query: para las consultas\n","    vector_consulta = embedding_model.encode(\n","        [\"query: \" + pregunta],\n","        convert_to_numpy=True,\n","        normalize_embeddings=True\n","    )[0]\n","\n","    resultados = client.query_points(\n","        collection_name=COLLECTION_NAME,\n","        query=vector_consulta.tolist(),\n","        limit=top_k,\n","        with_payload=True,\n","        with_vectors=False\n","    ).points\n","\n","    filas = []\n","\n","    for posicion, punto in enumerate(resultados, start=1):\n","        filas.append({\n","            \"ranking\": posicion,\n","            \"score\": round(float(punto.score), 4),\n","            \"documento\": punto.payload[\"documento\"],\n","            \"pagina\": punto.payload[\"pagina\"],\n","            \"chunk_id\": punto.payload[\"chunk_id\"],\n","            \"texto\": punto.payload[\"texto\"]\n","        })\n","\n","    return filas\n","\n","\n","# Consulta de prueba\n","pregunta_prueba = (\n","    \"¿Cuáles son los principales factores de riesgo \"\n","    \"de las enfermedades cardiovasculares?\"\n",")\n","\n","resultados_prueba = buscar_semanticamente(\n","    pregunta=pregunta_prueba,\n","    top_k=5\n",")\n","\n","for resultado in resultados_prueba:\n","    print(\"=\" * 80)\n","    print(\"Ranking:\", resultado[\"ranking\"])\n","    print(\"Similitud:\", resultado[\"score\"])\n","    print(\"Documento:\", resultado[\"documento\"])\n","    print(\"Página:\", resultado[\"pagina\"])\n","    print(\"Fragmento:\", resultado[\"chunk_id\"])\n","    print(\"Texto:\", resultado[\"texto\"][:700])\n","    print()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"jwr4L82_xE4V","executionInfo":{"status":"ok","timestamp":1791987371658,"user_tz":300,"elapsed":627,"user":{"displayName":"JUAN MANUEL BETANCUR LOPEZ","userId":"09952323565785544167"}},"outputId":"7e7d12ba-e653-43ef-f824-31ee92f53a22"},"execution_count":15,"outputs":[{"output_type":"stream","name":"stdout","text":["================================================================================\n","Ranking: 1\n","Similitud: 0.9121\n","Documento: 02_directrices-evaluacion-manejo-riesgo-cv-oms.pdf\n","Página: 24\n","Fragmento: chunk_001251\n","Texto: o), la inactividad física, la posición socioeconómica baja y los antecedentes familiares de enfermedades cardiovasculares prematuras (enfermedades cardiovasculares en un pariente de primer grado antes de los 55 años en el caso de los hombres y 65 años en las mujeres) pueden modiﬁcar el riesgo cardiovascular. Estos factores de riesgo no están incluidos en los diagramas, que por consiguiente pu